Q,GAAG,CAAC,CAAC,QAAQ,QAAQ,GAAG;AAClE;AAEO,SAAS,oBAAoB,MAAmC;CACrE,MAAM,IAAI,IAAI,gBAAgB,KAAK,QAAQ,MAAM,EAAE,CAAC;CACpD,MAAM,MAAM,EAAE,IAAI,IAAI,KAAK,GAAE,CAAE,MAAM,GAAG,CAAC,CAAC,IAAI,MAAM;CACpD,IAAI,GAAG,WAAW,GAAG,OAAO;CAC5B,MAAM,IAAI,mCAAS;EACjB,MAAM,EAAE,IAAI,GAAG,KAAK;EAAI,OAAO,EAAE,IAAI,GAAG;EAAG,MAAM,EAAE,IAAI,GAAG,KAAK;EAAM,KAAK,EAAE,IAAI,GAAG,MAAM;EACzF,OAAO;GAAE,MAAM,EAAE,IAAI,IAAI,KAAK;GAAI,KAAK,GAAG;GAAI,KAAK,GAAG;GAAI,IAAI,EAAE,IAAI,IAAI;GAAG,IAAI,EAAE,IAAI,IAAI;GAAG,UAAU,EAAE,IAAI,GAAG;EAAE;CACnH,CAAC;CACD,OAAO,EAAE,QAAQ,IAAI;AACvB","names":[],"ignoreList":[],"sources":["model.ts"],"sourcesContent":["import { hijriDate, type HijriDate } from '../core/hijri'\nimport { hijriMonths, type NamingStyle } from '../core/prayer'\nimport { zoned, zonedTime } from '../core/tz'\nimport { sanitize, type ScreenConfig, type ScreenLanguage } from '../screen/config'\nimport { screenDay, type RowLookup, type ScreenDay } from '../screen/model'\nimport { LETTER_FOR, PAPER_SIZES, type LetterFor, type PaperSize } from './letter'\n\n/**\n * Printable sheets, worked out without the DOM. They reuse the masjid screen's\n * settings (place, names, iqamah, Jumu'ah), so a committee that set up the TV\n * can print the same times for the notice board, and anyone else just picks a\n * place. Official table first, as everywhere in the app.\n */\n\nexport type SheetKind = 'month' | 'wall' | 'year' | 'ramadan' | 'stickers' | 'tracker' | 'fasting' | 'letter'\nexport const SHEETS: readonly SheetKind[] = ['month', 'wall', 'year', 'ramadan', 'stickers', 'tracker', 'fasting', 'letter']\n\nexport interface PrintOptions {\n  sheet: SheetKind\n  /** The month shown by month, stickers and tracker. */\n  year: number\n  month: number\n  /** The prayer break letter: who it is for (work when missing). */\n  for?: LetterFor\n  /** The prayer break letter: A4 or US Letter paper (A4 when missing). */\n  paper?: PaperSize\n}\n\nexport interface SheetDay {\n  /** Noon on the day, in the place's zone. */\n  ms: number\n  year: number\n  month: number\n  day: number\n  /** 0 Sunday … 6 Saturday. */\n  weekday: number\n  hijri: HijriDate\n  times: ScreenDay\n}\n\nconst noon = (y: number, m: number, d: number, tz: string) => zonedTime(y, m, d, 12, 0, 0, tz)\n\n/** The Hijri date of a moment, as the community counts it (see core/season.ts). Defaults to Umm al-Qura with the ± day adjustment. */\nexport type HijriOf = (ms: number) => HijriDate\n\nfunction sheetDay(ms: number, c: ScreenConfig, lookup: RowLookup, hijriOf?: HijriOf): SheetDay {\n  const tz = c.place!.tz\n  const z = zoned(ms, tz)\n  return { ms, year: z.year, month: z.month, day: z.day, weekday: z.weekday, hijri: hijriOf ? hijriOf(ms) : hijriDate(ms, tz, c.hijriAdj), times: screenDay(ms, c, lookup)! }\n}\n\nexport function daysInMonth(year: number, month: number): number {\n  return new Date(Date.UTC(year, month, 0)).getUTCDate()\n}\n\n/** Every day of a Gregorian month at the configured place. */\nexport function monthDays(c: ScreenConfig, year: number, month: number, lookup: RowLookup, hijriOf?: HijriOf): SheetDay[] {\n  if (!c.place) return []\n  const out: SheetDay[] = []\n  for (let d = 1; d <= daysInMonth(year, month); d++) out.push(sheetDay(noon(year, month, d, c.place.tz), c, lookup, hijriOf))\n  return out\n}\n\n/** Today at the configured place, for the prayer break letter. */\nexport function todayDay(c: ScreenConfig, now: number, lookup: RowLookup): SheetDay[] {\n  if (!c.place) return []\n  const z = zoned(now, c.place.tz)\n  return [sheetDay(noon(z.year, z.month, z.day, c.place.tz), c, lookup)]\n}\n\n/**\n * The next Ramadan (or the current one) from `from`, as expected by the Umm\n * al-Qura calendar with the masjid's ±day adjustment. Local announcements decide.\n */\nexport function ramadanDays(c: ScreenConfig, from: number, lookup: RowLookup, hijriOf?: HijriOf): SheetDay[] {\n  if (!c.place) return []\n  const tz = c.place.tz\n  const h = hijriOf ?? ((ms: number) => hijriDate(ms, tz, c.hijriAdj))\n  const z = zoned(from, tz)\n  let ms = noon(z.year, z.month, z.day, tz)\n  // Back up to the first day if Ramadan has already begun.\n  while (h(ms).month === 9) ms -= 86_400_000\n  for (let i = 0; i < 400 && h(ms).month !== 9; i++) ms += 86_400_000\n  const out: SheetDay[] = []\n  while (h(ms).month === 9 && out.length < 30) {\n    const zz = zoned(ms, tz)\n    out.push(sheetDay(noon(zz.year, zz.month, zz.day, tz), c, lookup, hijriOf))\n    ms += 86_400_000\n  }\n  return out\n}\n\n/** \"Jamadilawal – Jamadilakhir 1448\" for the Hijri months a sheet covers. */\nexport function hijriSpan(days: SheetDay[], style: NamingStyle): string {\n  if (!days.length) return ''\n  const names = hijriMonths(style)\n  const a = days[0].hijri, b = days[days.length - 1].hijri\n  const n = (h: HijriDate) => names[h.month - 1]\n  if (a.month === b.month) return `${n(a)} ${a.year}`\n  return a.year === b.year ? `${n(a)} – ${n(b)} ${b.year}` : `${n(a)} ${a.year} – ${n(b)} ${b.year}`\n}\n\n/** \"5:41\" (the column says which half of the day) or \"05:41\". */\nexport function clock(ms: number, tz: string, h24: boolean): string {\n  const z = zoned(ms, tz)\n  const mm = String(z.minute).padStart(2, '0')\n  if (h24) return `${String(z.hour).padStart(2, '0')}:${mm}`\n  return `${z.hour % 12 === 0 ? 12 : z.hour % 12}:${mm}`\n}\n\n// MARK: Words\n\nexport interface PrintWords {\n  sheetName: Record<SheetKind, string>\n  sheetHint: Record<SheetKind, string>\n  date: string; day: string; hijri: string; fast: string; imsak: string; iftar: string\n  weekdays: string[]; weekdaysShort: string[]; months: string[]\n  official: (source: string) => string\n  calculated: (method: string) => string\n  ramadanNote: string\n  lastTen: string\n  iqamah: string; after: (n: number) => string\n  scan: string; myMonth: string; colourIn: string; reward: string; stars: string; name: string\n  cut: string\n  myFasts: string; colourStar: string; syawalSix: string; fastsKept: string\n}\n\nconst EN_MONTHS = 