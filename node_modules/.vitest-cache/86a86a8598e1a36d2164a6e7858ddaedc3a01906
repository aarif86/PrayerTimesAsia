SAAS,YAA4F;CACjK,OACE,iDAAC,OAAD;EAAK,OAAM;EAAY,MAAK;YACzB,QAAQ,KAAK,MAAM,iDAAC,UAAD;GAAQ,gBAAc,EAAE,UAAU;GAAO,eAAe,SAAS,EAAE,KAAK;aAAI,EAAE;EAAc;;;;UAAC;CAC9G;;;;;AAET;;AAGO,SAAS,YAAY,EAAE,KAAK,WAAkD;CACnF,MAAM,QAAQ,IAAI;CAClB,MAAM,OAAO,wCAAc,4BAAM,WAAW,GAAG,CAAC;CAChD,MAAM,cAAc,UAAU,MAC1B,GAAG,KAAK,KAAK,4BAAM,kBAAkB,IAAI,iBAAiB,0CAAgB,4BAAM,cAAc,IAAI,4BAAM,OAAO,cAC/G,UAAU,OAAO,UAAU,MAAM,IAAI,cAAc,OAAO,GAAG,KAAK,KAAK,4BAAM,OAAO;CACxF,MAAM,aAAa,IAAI,kBAAkB,qCAAW,4BAAM,MAAM;CAChE,OACE,iDAAC,UAAD;EAAQ,OAAO,gBAAgB,UAAU,YAAY;EAAU,eAAe,UAAU;GAAE,MAAM;GAAS;EAAI,CAAC;EAC5G,cAAY,6BAAG,sBAAsB;GAAE;GAAO,MAAM;GAAM,QAAQ;EAAW,CAAC;YADhF;GAEE,iDAAC,QAAD;IAAM,OAAM;IAAQ,OAAO,EAAE,YAAY,WAAW,OAAO;cAAI;GAAY;;;;;GAC3E,iDAAC,QAAD;IAAM,OAAM;cAAO,UAAU,cAAc,GAAG,KAAK,KAAK;GAAmB;;;;;GAC1E,CAAC,WAAW,iDAAC,QAAD,EAAM,OAAM,SAAU;;;;;GACnC,oDAAC,6BAAD;IAAM,MAAM,UAAU,KAAK;IAAI,OAAO;KAAE,SAAS;KAAK,MAAM;IAAO;GAAI;;;;;EACjE;;;;;;AAEZ;;AAGO,SAAS,WAAW,EAAE,OAA2B;CACtD,MAAM,QAAQ,IAAI;CAClB,MAAM,YAAY,UAAU,MACvB,4BAAM,kBAAkB,IAAI,iBAAiB,0CAAgB,4BAAM,cAAc,IAAI,4BAAM,OAAO,YACnG,UAAU,OAAO,UAAU,MAAM,IAAI,aAAa,4BAAM,OAAO;CACnE,MAAM,aAAa,IAAI,kBAAkB,qCAAW,4BAAM,MAAM;CAChE,MAAM,OAAO,wCAAc,4BAAM,WAAW,GAAG,CAAC;CAChD,OACE,iDAAC,UAAD;EAAQ,OAAM;EAAc,eAAe,UAAU;GAAE,MAAM;GAAS;EAAI,CAAC;EACzE,cAAY,6BAAG,sBAAsB;GAAE;GAAO,MAAM;GAAM,QAAQ;EAAW,CAAC;YADhF;GAEE,iDAAC,KAAD,YAAI,KAAQ;;;;;GAAE,YAAY,MAAM,cAAc;GAAG;GAAI,6BAAG,cAAc;GAAE;GAAE;EACpE;;;;;;AAEZ;AAEO,SAAS,YAAY,EAAE,SAAS,QAAQ,6BAAG,cAAc,KAA8C;CAC5G,OAAO,iDAAC,UAAD;EAAQ,OAAM;EAAqB;EAAS,cAAY;YAAO,oDAAC,0BAAD,EAAG,MAAM,GAAK;;;;;CAAS;;;;;AAC/F;;AAGO,SAAS,QAAQ,IAAY,MAA0C;CAC5E,OAAO,IAAI,KAAK,eAAe,qCAAU,EAAG;EAAE,UAAU,4BAAM;EAAU,GAAG;CAAK,CAAC,CAAC,CAAC,OAAO,IAAI,KAAK,EAAE,CAAC,CAAC,CAAC,QAAQ,KAAK,EAAE;AACzH","names":[],"ignoreList":[],"sources":["common.tsx"],"sourcesContent":["import type { ComponentChildren, JSX } from 'preact'\nimport { useEffect, useRef, useState } from 'preact/hooks'\nimport { ChevronLeft, Info, X } from 'lucide-preact'\nimport type { Coordinates, PrayerDay } from '../core/engine'\nimport type { Prayer } from '../core/prayer'\nimport { sourceAuthority } from '../core/official'\nimport type { SourceGrade } from '../core/sources'\nimport { store } from '../services/store'\nimport { appLocale, methodName, tr } from '../core/appWords'\nimport { timeKindTitle } from '../core/timeKind'\n\n/** A time with its AM/PM set smaller on the same baseline. Never wraps. */\nexport function TimeText({ ms, size = 28, weight = 600, class: cls, style }: { ms: number; size?: number; weight?: number; class?: string; style?: JSX.CSSProperties }) {\n  const p = store.timeParts(ms)\n  return (\n    <span class={`time ${cls ?? ''}`} style={{ fontSize: `${size}px`, fontWeight: weight, ...style }} aria-label={store.formatted(ms)}>\n      <span>{p.time}</span>\n      {p.suffix && <span class=\"sfx\" style={{ fontSize: `${size * 0.5}px` }}>{p.suffix}</span>}\n    </span>\n  )\n}\n\n/** \"9h 22m\", \"22m\", \"45s\". */\nexport function short(ms: number): string {\n  const s = Math.max(0, Math.ceil(ms / 1000))\n  if (s < 60) return `${s}s`\n  const minutes = Math.floor((s + 59) / 60)\n  const h = Math.floor(minutes / 60), m = minutes % 60\n  return h > 0 ? `${h}h ${m}m` : `${m}m`\n}\n\n/** short() for screen readers: \"3 hours 8 minutes\", read once when focused rather than every second. */\nexport function spokenShort(ms: number): string {\n  const s = Math.max(0, Math.ceil(ms / 1000))\n  if (s < 60) return 'less than a minute'\n  const minutes = Math.floor((s + 59) / 60)\n  const h = Math.floor(minutes / 60), m = minutes % 60\n  const hours = h ? `${h} hour${h === 1 ? '' : 's'}` : ''\n  const mins = m ? `${m} minute${m === 1 ? '' : 's'}` : ''\n  return [hours, mins].filter(Boolean).join(' ')\n}\n\nexport const GRADE_TINT: Record<SourceGrade, string> = {\n  A: 'var(--grade-a)', B: 'var(--grade-b)', C: 'var(--grade-c)', D: 'var(--grade-d)', F: 'var(--accent)',\n}\n\n// ---------- Sheets: one at a time, like iOS ----------\n\nexport type SheetKind =\n  | { kind: 'places'; forHome?: boolean } | { kind: 'sanad'; day: PrayerDay } | { kind: 'calendar' } | { kind: 'makers'; placement: string }\n  | { kind: 'journey' } | { kind: 'level' } | { kind: 'ar' } | { kind: 'falak-expert' } | { kind: 'shadow-steps' } | { kind: 'shadow-camera' } | { kind: 'alerts-help' } | { kind: 'credits' } | { kind: 'install' }\n  | { kind: 'move-out' } | { kind: 'move-in'; code?: string } | { kind: 'tracker' } | { kind: 'log-prayer'; prayer: Prayer; t: number } | { kind: 'log-catchup' } | { kind: 'ramadan' } | { kind: 'wakeup'; prayer?: Prayer | 'friday'; view?: 'check' }\n  | { kind: 'guide' } | { kind: 'feedback' } | { kind: 'review' } | { kind: 'suggest-room'; near?: Coordinates }\n\nlet current: SheetKind | null = null\nconst listeners = new Set<() => void>()\nexport function openSheet(s: SheetKind) { current = s; listeners.forEach((f) => f()) }\nexport function closeSheet() { current = null; listeners.forEach((f) => f()) }\n/** Ask the Prayer screen to show the day `offset` days from today (from the Hijri calendar). */\nconst dayListeners = new Set<(offset: number) => void>()\nexport function showDayOnPrayerScreen(offset: number) { dayListeners.forEach((f) => f(offset)) }\nexport function useDayRequests(set: (offset: number) => void) {\n  useEffect(() => { dayListeners.add(set); return () => { dayListeners.delete(set) } }, [set])\n}\n\nexport function useSheet(): SheetKind | null {\n  const [, set] = useState(0)\n  useEffect(() => { const f = () => set((x) => x + 1); listeners.add(f); return () => { listeners.delete(f) } }, [])\n  return current\n}\n\n/** `label` names the sheet for screen readers when it has no visible title. */\nexport function Sheet({ title, label, children, full, onDone, back }: { title?: string; label?: string; children: ComponentChildren; full?: boolean; onDone?: () => void; back?: string }) {\n  const done = onDone ?? closeSheet\n  const box = useRef<HTMLDivElement>(null)\n  // Keyboard and screen reader users land in the sheet, and go back where they were when it closes.\n  useEffect(() => {\n    const before = document.activeElement as HTMLElement | null\n    box.current?.focus({ preventScroll: true })\n    return () => { if (before?.isConnected) before.focus({ preventScroll: true }) }\n  }, [])\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') { done(); return }\n      // Keep Tab inside the sheet while it is open.\n      if (e.key !== 'Tab' || !box.current) return\n      const items = [...box.current.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])')]\n        .filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null)\n      if (!items.length) return\n      const first = items[0], last = items[items.length - 1]\n      if (e.shiftKey && (document.activeElement === first || document.activeElement === box.current)) { e.preventDefault(); last.focus() }\n      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus() }\n    }\n    window.addEventListener('keydown', onKey)\n    return () => window.removeEventListener('keydown', onKey)\n  }, [done])\n  return (\n    <div class=\"sheet-backdrop\" onClick={(e) => { if (e.target === e.currentTarget) done() }}>\n      <div ref={box} tabIndex={-1} class={`sheet ${full ? 'full' : ''}`} role=\"dialog\" aria-modal=\"true\" aria-label={title || label}>\n        {back ? (\n          <>\n            <div class=\"sheet-back\"><button onClick={done}><ChevronLeft size={24} />{back}</button></div>\n            {title && <h1 class=\"sheet-pagetitle\">{title}</h1>}\n          </>\n        ) : (\n          <>\n            <div class=\"grabber\" />\n            <div class=\"sheet-head\">\n              <span style={{ width: '64px' }} />\n              {title ? <h2>{title}</h2> : <span />}\n              <button class=\"done\" onClick={done}>{tr('common.done')}</button>\n            </div>\n          </>\n        )}\n        {children}\n      </div>\n    </div>\n  )\n}\n\n// ---------- Controls ----------\n\nexport function Switch({ on, onChange, label }: { on: boolean; onChange: (v: boolean) => void; label: string }) {\n  return <button class=\"switch\" role=\"switch\" aria-checked={on} aria-label={label} onClick={() => onChange(!on)} />\n}\n\nexport function ToggleItem({ label, sub, on, onChange }: { label: string; sub?: string; on: boolean; onChange: (v: boolean) => void }) {\n  return (\n    <div class=\"item\">\n      <span class=\"label\">{label}{sub && <span class=\"sub\">{sub}</span>}</span>\n      <Switch on={on} onChange={onChange} label={label} />\n    </div>\n  )\n}\n\nexport function SelectItem<T extends string>({ label, value, options, onChange, sub }: {\n  label: string; value: T; options: { value: T; label: string }[]; onChange: (v: T) => void; sub?: string\n}) {\n  return (\n    <label class=\"item\">\n      <span class=\"label\">{label}{sub && <span class=\"sub\">{sub}</span>}</span>\n      <select value={value} onChange={(e) => onChange((e.target as HTMLSelectElement).value as T)}>\n        {options.map((o) => <option value={o.value}>{o.label}</option>)}\n      </select>\n    </label>\n  )\n}\n\nexport function Segmented<T extends string | number>({ value, options, onChange }: { value: T; options: { value: T; label: string }[]; onChange: (v: T) => void }) {\n  return (\n    <div class=\"segmented\" role=\"group\">\n      {options.map((o) => <button aria-pressed={o.value === value} onClick={() => onChange(o.value)}>{o.label}</button>)}\n    </div>\n  )\n}\n\n/** \"Every time has a source. We show it.\" The badge by the prayer list. */\nexport function SourceBadge({ day, compact }: { day: PrayerDay; compact?: boolean }) {\n  const grade = day.grade\n  const kind = timeKindTitle(store.timeKindOf(day))\n  const shortSource = grade === 'A'\n    ? `${kind} · ${store.officialSource && day.officialSource ? sourceAuthority(store.officialSource) : store.method.shortName}`\n    : grade === 'B' || grade === 'C' ? day.mosqueName ?? kind : `${kind} · ${store.method.shortName}`\n  const sourceName = day.officialSource ?? methodName(store.method)\n  return (\n    <button class={`source-badge ${compact ? 'compact' : 'full'}`} onClick={() => openSheet({ kind: 'sanad', day })}\n      aria-label={tr('common.sourceBadge', { grade, name: kind, detail: sourceName })}>\n      <span class=\"grade\" style={{ background: GRADE_TINT[grade] }}>{grade}</span>\n      <span class=\"src\">{compact ? shortSource : `${kind} · ${sourceName}`}</span>\n      {!compact && <span class=\"spacer\" />}\n      <Info size={compact ? 12 : 15} style={{ opacity: 0.7, flex: 'none' }} />\n    </button>\n  )\n}\n\n/** The quiet source line under the Centre Dial list: \"Official · MUIS · Grade A\". Tap for the full story. */\nexport function SourceLine({ day }: { day: PrayerDay }) {\n  const grade = day.grade\n  const authority = grade === 'A'\n    ? (store.officialSource && day.officialSource ? sourceAuthority(store.officialSource) : store.method.shortName)\n    : grade === 'B' || grade === 'C' ? day.mosqueName : store.method.shortName\n  const sourceName = day.officialSource ?? methodName(store.method)\n  const kind = timeKindTitle(store.timeKindOf(day))\n  return (\n    <button class=\"source-line\" onClick={() => openSheet({ kind: 'sanad', day })}\n      aria-label={tr('common.sourceBadge', { grade, name: kind, detail: sourceName })}>\n      <b>{kind}</b>{authority ? ` · ${authority}` : ''} · {tr('source.grade')} {grade}\n    </button>\n  )\n}\n\nexport function CloseButton({ onClick, label = tr('common.close') }: { onClick: () => void; label?: string }) {\n  return <button class=\"round-btn\" onClick={onClick} aria-label={label}><X size={16} /></button>\n}\n\n/** Formats a date in the place's zone. */\nexport function fmtDate(ms: number, opts: Intl.DateTimeFormatOptions): string {\n  return new Intl.DateTimeFormat(appLocale(), { timeZone: store.timeZone, ...opts }).format(new Date(ms)).replace(',', '')\n}\n"],"file":"/web/src/ui/common.tsx"}