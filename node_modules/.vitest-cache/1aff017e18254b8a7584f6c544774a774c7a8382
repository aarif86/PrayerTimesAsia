/** The windows that start on `day`, in order. Isyak runs into `nextDay`. */
function windowsOf(day, nextDay) {
	const t = day.times;
	return [
		{
			prayer: "fajr",
			start: t.fajr,
			end: t.sunrise
		},
		{
			prayer: "dhuhr",
			start: t.dhuhr,
			end: t.asr
		},
		{
			prayer: "asr",
			start: t.asr,
			end: t.maghrib
		},
		{
			prayer: "maghrib",
			start: t.maghrib,
			end: t.isha
		},
		{
			prayer: "isha",
			start: t.isha,
			end: nextDay.times.fajr
		}
	];
};
