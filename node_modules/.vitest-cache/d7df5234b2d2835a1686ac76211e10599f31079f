Y,aAAa,YAAY,OAAO,EAAE,YAAY,cAAc;AACxG;AAEA,MAAM,MAAM;;AAGL,SAAS,mBAA4B;CAC1C,IAAI;EACF,MAAM,QAAQ,IAAI,KAAK,eAAe,WAAW,EAAE,MAAM,UAAU,CAAC,CAAC,CAAC,gBAAgB,CAAC,CAAC;EACxF,OAAO,UAAU,SAAS,UAAU;CACtC,QAAQ;EACN,OAAO;CACT;AACF;AAEO,SAAS,kBAA+B;CAC7C,IAAI;EACF,MAAM,IAAI,aAAa,QAAQ,GAAG;EAClC,OAAO,IAAI,kBAAkB,KAAK,MAAM,CAAC,CAAC,IAAI;GAAE,GAAG,gBAAgB,aAAa;GAAG,WAAW,iBAAiB;EAAE;CACnH,QAAQ;EACN,OAAO,gBAAgB,aAAa;CACtC;AACF;AAEO,SAAS,gBAAgB,GAAsB;CACpD,IAAI;EAAE,aAAa,QAAQ,KAAK,KAAK,UAAU,CAAC,CAAC;CAAE,QAAQ,CAAqC;AAClG;;AAGO,MAAM,2BAA2B;AACjC,MAAM,mBAAmB;CAAC;CAAG;CAAI;CAAI;CAAI;CAAI;CAAI;AAAE;;AAGnD,MAAM,0BAA0B","names":[],"ignoreList":[],"sources":["prefs.ts"],"sourcesContent":["import { unifyAlerts } from '../core/alertMode'\nimport type { ExtraAlerts } from '../core/extraAlerts'\nimport { JUMUAH_LEAVE_CHOICES, snapLeaveMinutes, type JumuahSession } from '../core/jumuahLeave'\nimport { TARAWIH_RAKAAT } from '../core/tarawih'\nimport type { MasjidLink } from '../core/masjidLink'\nimport type { Place } from '../core/place'\nimport type { FastMark } from '../core/ramadanContent'\nimport { SEASON_PREVIEWS, type SeasonPreview } from '../core/season'\nimport { NAMING_STYLES, OBLIGATORY, type AsrSchool, type NamingStyle, type Prayer } from '../core/prayer'\nimport { cleanAwayMinutes, DEFAULT_AWAY_MINUTES } from '../core/away'\nimport {\n  ALARM_SOUNDS, DEFAULT_SAHUR_DAYS, PRAYER_ALARM_TIMINGS, SAHUR_DAYS, SAHUR_TIMINGS, WAKE_UP_TIMINGS,\n  type AlarmSound, type PrayerAlarmTiming, type SahurDay, type SahurTiming, type WakeUpTiming,\n} from '../core/wakeup'\n\nexport type AppLanguage = 'en' | 'ms' | 'id'\nexport const APP_LANGUAGES: readonly AppLanguage[] = ['en', 'ms', 'id']\n\nexport type Appearance = 'system' | 'light' | 'dark'\nexport const APPEARANCES: Appearance[] = ['system', 'light', 'dark']\n/** Where the Sections bar sits on bigger screens (laptop, tablet): the arrow on the bar moves it. Phones always keep it at the bottom. */\nexport const MENU_SIDES = ['auto', 'bottom', 'left', 'right'] as const\nexport type MenuSide = (typeof MENU_SIDES)[number]\n\nexport const APPEARANCE_LABEL: Record<Appearance, string> = {\n  system: 'Automatic (follows the sky)', light: 'Light', dark: 'Dark',\n}\n\n/** How the Prayer screen shows the day (same order as the iOS TodayStyle). */\nexport type TodayStyle = 'centre' | 'sunPath' | 'bands' | 'simple' | 'gold'\nexport const TODAY_STYLES: TodayStyle[] = ['centre', 'sunPath', 'bands', 'simple', 'gold']\nexport const TODAY_STYLE_LABEL: Record<TodayStyle, string> = {\n  centre: 'Centre Dial', sunPath: 'Sun Path', bands: 'Colour Bands', simple: 'Big and Simple', gold: 'Calm Gold',\n}\n\nexport interface TripStop { countryCode: string; countryName: string; placeName: string; arrived: number }\n\n/**\n * Everything the user chooses, kept in this browser only. `null` overrides mean\n * \"automatic for the country I'm in\" - the travel-mode behaviour.\n */\nexport interface Preferences {\n  hasOnboarded: boolean\n  useGPS: boolean\n  manualPlace: Place | null\n  savedPlaces: Place[]\n  home: Place | null\n  /** The user said this is home (or picked it). Until then home is only a guess and Journey asks about it. */\n  homeConfirmed: boolean\n  methodOverrideID: string | null\n  asrOverride: AsrSchool | null\n  namingOverride: NamingStyle | null\n  /** The language of the app's words. null = from the browser's language (English unless Malay or Indonesian). */\n  appLanguageOverride: AppLanguage | null\n  use24Hour: boolean\n  hijriAdjustment: number\n  notificationsEnabled: boolean\n  notifyPrayers: Prayer[]\n  /** Minutes before each chosen prayer for \"Reminder before prayer\"; 0 = off. Separate from the alert at the time itself. */\n  reminderMinutesBefore: number\n  /** Early reminder when the phone is away from the confirmed home (core/away.ts). On by default, 1 hour, Fajr off. */\n  awayReminder: boolean\n  awayMinutes: Record<string, number>\n  /** Prayer time alerts play the azan (a Subuh azan at Subuh) when the app has the recordings - see services/azan.ts. */\n  azanSound: boolean\n  /** Full azan instead of the short call (opening takbir only). Fajr always uses the short call. */\n  azanFull: boolean\n  /** Which azan voice plays (services/azan.ts). Falls back to the first voice in the app. */\n  azanVoice: string\n  musafirThresholdKm: number\n  jakimZoneOverride: string | null\n  lastCountryCode: string | null\n  arrivedAt: number | null\n  arrivalBannerDismissed: boolean\n  /** The big \"Musafir\" line was closed for this trip; the luggage button stays with the other buttons. Reset on each new arrival. */\n  musafirChipDismissed: boolean\n  /** Long summer days notes closed, one per place and summer (core/longDays.ts longDaysKey). Stays on this device. */\n  longDaysClosed: string[]\n  /** \"Your times follow another country\" notes closed, one per method and country (\"jakim>SG\"). Stays on this device. */\n  sourceAwayClosed: string[]\n  trip: TripStop[]\n  trackerEnabled: boolean\n  prayedLog: Record<string, Prayer[]>\n  excusedDays: string[]\n  /** \"yyyy-MM-dd\" the tracker was paused (haid, nifas, illness); every day from then until it is ended counts as excused. */\n  trackerPausedSince: string | null\n  /** When each prayer was ticked (ms), by day. Only used to show the small \"6:15 AM\" after the tick. */\n  prayedAt: Record<string, Partial<Record<Prayer, number>>>\n  /** Show that time after the tick. Off keeps just the tick. */\n  trackerShowTime: boolean\n  /** The Subuh alarm; null = off. On the web it rings only while the app is open (or through the calendar file). */\n  wakeUp: WakeUpTiming | null\n  /** The earlier sahur alarm; null = off. Rings only on `sahurDays`. */\n  sahurAlarm: SahurTiming | null\n  sahurDays: SahurDay[]\n  /** Alarms for the other prayers (null = off), and the sound every alarm plays. */\n  dhuhrAlarm: PrayerAlarmTiming | null\n  asrAlarm: PrayerAlarmTiming | null\n  maghribAlarm: PrayerAlarmTiming | null\n  ishaAlarm: PrayerAlarmTiming | null\n  alarmSound: AlarmSound\n  communityAuthority: string | null\n  appearance: Appearance\n  todayStyle: TodayStyle\n  showOffers: boolean\n  musafirEnabled: boolean\n  showLocalNames: boolean\n  alertsPromptDismissed: boolean\n  appPromptDismissed: boolean\n  /** The masjid whose iqamah times show on the Prayer screen, from its screen's QR code. */\n  myMasjid: MasjidLink | null\n  /** Anonymous usage counts (city and country, never coordinates). See services/usage.ts. */\n  shareUsage: boolean\n  // Ramadan and Syawal\n  /** For testers: pretend today is a day in Ramadan or Syawal. Never moved to another phone. */\n  seasonPreview: SeasonPreview\n  /** \"Imsak in 10 minutes\" in Ramadan. */\n  imsakAlert: boolean\n  /** \"Time to berbuka\" at Maghrib in Ramadan. */\n  berbukaAlert: boolean\n  /** The last ten nights: a gentle alert at the last third of the night. */\n  qiyamAlert: boolean\n  /** Off, Notify or Alarm for Dhuha, the middle of the night and the last third (core/extraAlerts.ts). */\n  extraAlerts: ExtraAlerts\n  /** Ramadan screen: a juz a day to finish the Quran in the month. */\n  khatamPlan: boolean\n  /** \"yyyy-MM-dd\" to how that day's fast went (fasted, a reason it was missed, a replaced or Syawal fast). */\n  fastLog: Record<string, FastMark>\n  /** Days Tarawih was prayed. */\n  tarawihLog: string[]\n  /** How many rakaat of Tarawih the user prays, for the counter; null until they choose. */\n  tarawihRakaat: 8 | 20 | null\n  /** Days the day's juz was read. */\n  quranLog: string[]\n  /** Hijri years zakat fitrah was paid. */\n  zakatPaid: number[]\n  /** Tracker users: one nudge before a prayer's time runs out, if it isn't ticked. */\n  windowNudge: boolean\n  /** Alerts go silent (buzz only) between these minutes past midnight; Subuh still rings. */\n  quietHours: boolean\n  quietFrom: number\n  quietTo: number\n  /** Every alert buzzes only, never a sound. */\n  buzzOnly: boolean\n  /** Bigger text everywhere, for older eyes. */\n  largeText: boolean\n  /** Web only: where the Sections bar sits on bigger screens. */\n  menuSide: MenuSide\n  /** The moving opening screen. Off goes straight to the app; it still shows the first time. */\n  showOpening: boolean\n  /** The quick guide (seven swipe cards) was seen or skipped. Settings opens it again. */\n  guideShown: boolean\n  /** Fridays: a reminder this many minutes before Jumaat (0 = off). */\n  jumuahReminderMinutes: number\n  /** Singapore only: leave for the first Jumaat (at Zohor) or the second one some masjids hold from 2 PM. */\n  jumuahSession: JumuahSession\n  /** The leave reminder rings like the prayer alarms instead of a quiet notification. */\n  jumuahLeaveAlarm: boolean\n  /** Short hadith and ayat on some screens (see core/hadith.ts). */\n  showHadith: boolean\n  /** One hadith line under prayer alerts and the Subuh alarm. */\n  hadithInAlerts: boolean\n  /** Hadith closed with their ✕, by id. Turning Show hadith back on brings them all back. */\n  hiddenHadith: string[]\n  /** Separate days the app was opened, for the one gentle \"note to the makers\" card. */\n  openDayCount: number\n  /** \"yyyy-MM-dd\" of the last counted open. */\n  lastOpenDay: string\n  /** When a note to the makers was last started (ms), 0 = never. */\n  feedbackSentAt: number\n  /** The one gentle \"note to the makers\" card was closed or used; it never comes back. */\n  noteCardDone: boolean\n  /** When a public review link was last tapped (ms), 0 = never. */\n  reviewTappedAt: number\n  /** The review words written once in Rate and review, kept on this device to paste in each store. */\n  reviewDraft: string\n}\n\nexport const DEFAULT_PREFS: Preferences = {\n  hasOnboarded: false,\n  useGPS: true,\n  manualPlace: null,\n  savedPlaces: [],\n  home: null,\n  homeConfirmed: false,\n  methodOverrideID: null,\n  asrOverride: null,\n  namingOverride: null,\n  appLanguageOverride: null,\n  use24Hour: false,\n  hijriAdjustment: 0,\n  // New installs are told when each prayer begins. Alerts only go out once the browser or phone allows them.\n  notificationsEnabled: true,\n  notifyPrayers: [...OBLIGATORY],\n  reminderMinutesBefore: 0,\n  awayReminder: true,\n  awayMinutes: { ...DEFAULT_AWAY_MINUTES },\n  azanSound: true,\n  azanFull: false,\n  azanVoice: 'asim',\n  musafirThresholdKm: 81,\n  jakimZoneOverride: null,\n  lastCountryCode: null,\n  arrivedAt: null,\n  arrivalBannerDismissed: true,\n  musafirChipDismissed: false,\n  longDaysClosed: [],\n  sourceAwayClosed: [],\n  trip: [],\n  trackerEnabled: false,\n  prayedLog: {},\n  excusedDays: [],\n  trackerPausedSince: null,\n  prayedAt: {},\n  trackerShowTime: true,\n  wakeUp: null,\n  sahurAlarm: null,\n  sahurDays: [...DEFAULT_SAHUR_DAYS],\n  dhuhrAlarm: null,\n  asrAlarm: null,\n  maghribAlarm: null,\n  ishaAlarm: null,\n  alarmSound: 'classic',\n  communityAuthority: null,\n  appearance: 'system',\n  todayStyle: 'centre',\n  showOffers: true,\n  musafirEnabled: false,\n  showLocalNames: true,\n  alertsPromptDismissed: false,\n  appPromptDismissed: false,\n  myMasjid: null,\n  shareUsage: true,\n  seasonPreview: 'off',\n  imsakAlert: true,\n  berbukaAlert: true,\n  qiyamAlert: false,\n  extraAlerts: {},\n  khatamPlan: false,\n  fastLog: {},\n  tarawihLog: [],\n  tarawihRakaat: null,\n  quranLog: [],\n  zakatPaid: [],\n  windowNudge: true,\n  quietHours: false,\n  quietFrom: 23 * 60,\n  quietTo: 6 * 60,\n  buzzOnly: false,\n  largeText: false,\n  menuSide: 'auto',\n  showOpening: true,\n  guideShown: false,\n  jumuahReminderMinutes: 0,\n  jumuahSession: 'first',\n  jumuahLeaveAlarm: false,\n  showHadith: true,\n  hadithInAlerts: true,\n  hiddenHadith: [],\n  openDayCount: 0,\n  lastOpenDay: '',\n  feedbackSentAt: 0,\n  noteCardDone: false,\n  reviewTappedAt: 0,\n  reviewDraft: '',\n}\n\nconst NULLABLE = new Set<keyof Preferences>(['tarawihRakaat', \n  'manualPlace', 'home', 'methodOverrideID', 'asrOverride', 'namingOverride', 'appLanguageOverride', 'jakimZoneOverride',\n  'lastCountryCode', 'arrivedAt', 'communityAuthority', 'myMasjid', 'trackerPausedSince', 'wakeUp', 'sahurAlarm',\n  'dhuhrAlarm', 'asrAlarm', 'maghribAlarm', 'ishaAlarm',\n])\n\nconst ENUMS: Partial<Record<keyof Preferences, readonly string[]>> = {\n  appearance: ['system', 'light', 'dark'],\n  menuSide: MENU_SIDES,\n  todayStyle: ['centre', 'sunPath', 'bands', 'simple', 'gold'],\n  asrOverride: ['standard', 'hanafi'],\n  namingOverride: NAMING_STYLES,\n  appLanguageOverride: APP_LANGUAGES,\n  seasonPreview: SEASON_PREVIEWS,\n  wakeUp: WAKE_UP_TIMINGS,\n  sahurAlarm: SAHUR_TIMINGS,\n  dhuhrAlarm: PRAYER_ALARM_TIMINGS,\n  asrAlarm: PRAYER_ALARM_TIMINGS,\n  maghribAlarm: PRAYER_ALARM_TIMINGS,\n  ishaAlarm: PRAYER_ALARM_TIMINGS,\n  alarmSound: ALARM_SOUNDS,\n}\n\n/**\n * Field by field with defaults, so adding a preference in an update never throws\n * away the ones a user already set (same rule as the iOS Preferences decoder).\n */\nexport function decodePreferences(raw: unknown): Preferences {\n  const out: Preferences = structuredClone(DEFAULT_PREFS)\n  if (!raw || typeof raw !== 'object') return out\n  const r = { ...(raw as Record<string, unknown>) }\n  // Saved settings without this choice come from before the default changed: keep them Off.\n  if (!('notificationsEnabled' in r)) r.notificationsEnabled = false\n  // Side Dial and Day Dial are retired: anyone on them moves to Centre Dial.\n  if (r.todayStyle === 'list' || r.todayStyle === 'dial') r.todayStyle = 'centre'\n  for (const key of Object.keys(DEFAULT_PREFS) as (keyof Preferences)[]) {\n    if (!(key in r)) continue\n    const v = r[key]\n    const d = DEFAULT_PREFS[key]\n    if (v === null) { if (NULLABLE.has(key)) (out as unknown as Record<string, unknown>)[key] = null; continue }\n    const allowed = ENUMS[key]\n    if (allowed && !(typeof v === 'string' && allowed.includes(v))) continue\n    if (NULLABLE.has(key) && d === null) {\n      // Nullable values: accept the right primitive or