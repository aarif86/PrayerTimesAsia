  unifyAlerts(out)\n  out.awayMinutes = cleanAwayMinutes(out.awayMinutes)\n  // Dhuha and night time alerts: keep only the three known times with Notify or Alarm.\n  const extra: ExtraAlerts = {}\n  for (const b of ['dhuha', 'midnight', 'lastThird'] as const) { const m = out.extraAlerts?.[b]; if (m === 'notify' || m === 'alarm') extra[b] = m }\n  out.extraAlerts = extra\n  return out\n}\n\nfunction isMasjid(v: unknown): v is MasjidLink {\n  const m = v as MasjidLink\n  return !!m && typeof m === 'object' && typeof m.name === 'string' && typeof m.lat === 'number' &&\n    typeof m.lng === 'number' && typeof m.tz === 'string' && !!m.jamaah && typeof m.jamaah === 'object'\n}\n\nfunction isPlace(v: unknown): v is Place {\n  const p = v as Place\n  return !!p && typeof p === 'object' && typeof p.name === 'string' && typeof p.timeZoneID === 'string' &&\n    !!p.coordinates && typeof p.coordinates.latitude === 'number' && typeof p.coordinates.longitude === 'number'\n}\n\nconst KEY = 'ptasia.preferences.v1'\n\n/** A new visitor's 24 hour setting follows the device's own clock; after that it is their choice. */\nexport function deviceUses24Hour(): boolean {\n  try {\n    const cycle = new Intl.DateTimeFormat(undefined, { hour: 'numeric' }).resolvedOptions().hourCycle\n    return cycle === 'h23' || cycle === 'h24'\n  } catch {\n    return false\n  }\n}\n\nexport function loadPreferences(): Preferences {\n  try {\n    const s = localStorage.getItem(KEY)\n    return s ? decodePreferences(JSON.parse(s)) : { ...structuredClone(DEFAULT_PREFS), use24Hour: deviceUses24Hour() }\n  } catch {\n    return structuredClone(DEFAULT_PREFS)\n  }\n}\n\nexport function savePreferences(p: Preferences): void {\n  try { localStorage.setItem(KEY, JSON.stringify(p)) } catch { /* private mode: keep in memory */ }\n}\n\n/** \"Reminder before prayer\": on at 15 minutes, any of these to choose from. */\nexport const DEFAULT_REMINDER_MINUTES = 15\nexport const REMINDER_CHOICES = [5, 10, 15, 20, 30, 45, 6